{% extends '_layouts/cp' %}

{% do view.registerAssetBundle('dilewe\\release\\assetbundles\\verffentlichencpsection\\VerffentlichenCPSectionAsset') %}

{% set title = 'Veröffentlichen' %}
{% set docsUrl = 'https://github.com/Digitale-Lernwelten/release-button/blob/master/README.md' %}
{% set assetPath = '@dilewe/release/assetbundles/verffentlichencpsection/dist' %}
{% set assetUrl = view.assetManager.getPublishedUrl(assetPath, true) %}

{% set content %}
    <div class="release-panel">
        <button id="release-button" class="release-button" type="button" data-configured="{{ configured ? '1' : '0' }}" {% if not configured %}disabled{% endif %}>
            Veröffentlichen <span aria-hidden="true">→</span>
        </button>

        <div class="release-animation" aria-hidden="true">
            <video id="release-hello" autoplay muted playsinline>
                <source src="{{ assetUrl }}/img/Monstrohello.mp4" type="video/mp4">
            </video>
            <img id="release-waiting" src="{{ assetUrl }}/img/Monstrowaiting.jpg" alt="" hidden>
            <video id="release-done" muted playsinline hidden>
                <source src="{{ assetUrl }}/img/Monstroexited.mp4" type="video/mp4">
            </video>
        </div>

        <p id="release-status" role="status" aria-live="polite">
            {% if not configured %}CRAFT_RELEASE_URL und CRAFT_RELEASE_SECRET müssen konfiguriert sein.{% endif %}
        </p>
    </div>
{% endset %}
